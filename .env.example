# ====================================================
# PlacementX — Environment Variables Template
# ====================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ====================================================

# Supabase Configuration
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=student-documents
SUPABASE_REPORTS_BUCKET=generated-reports

# Firebase Authentication and push notification configuration
# Browser Firebase values are public identifiers, not authorization secrets.
# Restrict the API key to the intended Firebase APIs and web/app identifiers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Server-only. Prefer workload identity/application-default credentials in production.
FIREBASE_DATABASE_URL=
# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_KEY=

# JWT
JWT_SECRET=
# Keep browser access tokens short-lived. Users can sign in again after expiry.
JWT_ACCESS_EXPIRES_IN=15m

# Redis (Queue Backend)
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Local Docker only (keep the password in your untracked .env)
POSTGRES_USER=placementx
POSTGRES_PASSWORD=
POSTGRES_DB=placementx

# Application
VITE_APP_NAME=PlacementX
VITE_APP_ENV=development
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Set true only when requests pass through a trusted reverse proxy.
TRUST_PROXY=false
# Authentication rate limit per IP and account identifier.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# JWT metadata prevents tokens minted for another service being accepted.
JWT_ISSUER=placementx-api
JWT_AUDIENCE=placementx-clients

# Development only: these non-deliverable Firebase demo accounts may sign in
# without email verification. Production always ignores this exception.
DEMO_EMAIL_ALLOWLIST=admin@nmims.edu,kunal.khaire177@nmims.in

# One-time trusted administrator provisioning; do not commit these values.
# SEED_ADMIN_EMAIL=admin@nmims.edu
# SEED_ADMIN_PASSWORD=
# Set only for a trusted, pre-approved administrator provisioning action.
# SEED_VERIFY_ADMIN_EMAIL=false

# Mobile standalone build API (existing dev/staging deployment)
EXPO_PUBLIC_API_URL=https://your-existing-staging-api.example.com/api
