generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id                      String                  @id @default(uuid())
  firebaseUid             String?                 @unique
  email                   String                  @unique
  password                String
  role                    String                  @default("STUDENT")
  mustChangePassword      Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  adminProfile            AdminProfile?
  coordinatorProfile      CoordinatorProfile?
  deviceTokens            DeviceToken[]
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  studentProfile          StudentProfile?
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  createdAt  DateTime @default(now())
  deviceName String?
  platform   String   @default("android")
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  firstName         String?
  lastName          String?
  phone             String?
  branch            String?
  cgpa              Float?
  passingYear       Int?
  activeBacklogs    Int      @default(0)
  yearGap           Int      @default(0)
  nationality       String?
  gender            String?
  resumeUrl         String?
  photoUrl          String?
  portfolioUrl      String?
  githubUrl         String?
  linkedinUrl       String?
  skills               Json?
  programmingLanguages Json?
  projects             Json?
  codingProfiles       Json?
  educationDetails     String?
  isProfileComplete Boolean  @default(false)
  profileStatus     String   @default("NOT_COMPLETED")
  verifiedAt        DateTime?
  verifiedBy        String?
  // Personal Details
  dateOfBirth       DateTime?
  address           String?
  alternatePhone    String?
  category          String?

  // Academic Details (Past)
  tenthBoard        String?
  tenthYear         Int?
  tenthPercentage   Float?
  twelfthBoard      String?
  twelfthYear       Int?
  twelfthPercentage Float?
  diplomaBoard      String?
  diplomaYear       Int?
  diplomaPercentage Float?
  
  // Current Academics
  currentSemester   Int?
  totalBacklogs     Int      @default(0)

  // Professional Details
  certifications    Json?
  experience        Json?
  languages         Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // AI Extensions
  predictedSuccessRate Float?
  riskLevel            String?
  riskFactors          Json?
  recommendedCompanies Json?
  recommendedJobs      Json?
  lastPredictionAt     DateTime?
  profileEmbedding     Unsupported("vector(384)")?

  applications   DriveApplication[]
  updateRequests ProfileUpdateRequest[]
  auditLogs      ProfileAuditLog[]
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoordinatorProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  firstName  String?
  lastName   String?
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          String           @id @default(uuid())
  name        String
  logoUrl     String?
  website     String?
  industry    String?
  profile     String?
  hrName      String?
  hrEmail     String?
  hrContact   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  description String?
  linkedInUrl String?
  location    String?
  workMode    String?
  drives      PlacementDrive[]
}

model PlacementDrive {
  id                       String    @id @default(uuid())
  companyId                String
  status                   String    @default("WAITING_FOR_HR")
  jobRole                  String?
  jobDescription           String?
  fixedSalary              Float?
  variableSalary           Float?
  internshipStipend        Float?
  employmentType           String?
  ppoAvailable             Boolean   @default(false)
  bondDetails              String?
  vacancies                Int?
  location                 String?
  workMode                 String?
  eligibleBranches         String?
  passingYear              Int?
  minimumCgpa              Float?
  activeBacklogsAllowed    Int       @default(0)
  yearGapAllowed           Int       @default(0)
  maximumLiveOffers        Int       @default(1)
  genderRestriction        String?
  registrationStart        DateTime?
  registrationEnd          DateTime?
  nominationLink           String?
  maximumApplicants        Int?
  resumeMandatory          Boolean   @default(true)
  portfolioRequired        Boolean   @default(false)
  githubRequired           Boolean   @default(false)
  attachments              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  academicYear             String?
  applicationDeadline      DateTime?
  benefits                 String?
  campus                   String?
  consentGiven             Boolean   @default(false)
  department               String?
  driveTitle               String?
  driveType                String?
  expectedDriveDate        DateTime?
  historyOfBacklogsAllowed Int       @default(0)
  joiningBonus             Float?
  linkedinRequired         Boolean   @default(false)
  maximumGapYears          Int       @default(0)
  minimumAttendance        Float?
  placementSeason          String?
  preferredSkills          String?
  remarks                  String?
  requiredSkills           String?
  semester                 Int?
  specialInstructions      String?
  technologyStack          String?
  trainingPeriod           String?

  // AI Extensions
  jobEmbedding Unsupported("vector(384)")?
  semanticTags Json?

  applications    DriveApplication[]
  auditLogs       DriveAuditLog[]
  hrInvitations   HrInvitationLink[]
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  selectionRounds SelectionRound[]
}

model SelectionRound {
  id                 String         @id @default(uuid())
  driveId            String
  roundNumber        Int
  title              String
  date               DateTime?
  time               String?
  duration           String?
  venue              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  evaluationCriteria String?
  instructions       String?
  interviewer        String?
  order              Int            @default(0)
  platform           String?
  roundType          String?
  weightage          Float?
  drive              PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
}

model DriveApplication {
  id               String         @id @default(uuid())
  driveId          String
  studentId        String
  status           String         @default("APPLIED")
  appliedAt        DateTime       @default(now())
  interviewSchedule Json?
  drive            PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offerLetter      OfferLetter?

  @@unique([driveId, studentId])
}

model OfferLetter {
  id                  String           @id @default(uuid())
  applicationId       String           @unique
  offerLetterUrl      String?
  joiningLetterUrl    String?
  internshipLetterUrl String?
  uploadedAt          DateTime         @default(now())
  application         DriveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String    @id @default(uuid())
  title          String
  message        String
  type           String    @default("system")
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  actionUrl      String?
  expiresAt      DateTime?
  metadata       Json?
  priority       String    @default("MEDIUM")
  readAt         DateTime?
  receiverId     String
  receiverRole   String    @default("STUDENT")
  senderId       String?
  senderRole     String?
  updatedAt      DateTime  @updatedAt
  category       String    @default("system")
  deepLinkParams Json?
  deepLinkRoute  String?
  image          String?
  isArchived     Boolean   @default(false)
  isDeleted      Boolean   @default(false)
  campaignId     String?
  user           User      @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  campaign       NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([receiverId, isDeleted, createdAt])
  @@index([receiverId, isRead, isDeleted])
  @@index([receiverId, category, isDeleted])
  @@index([receiverId, type, isDeleted])
  @@index([campaignId])
}

model NotificationCampaign {
  id             String    @id @default(uuid())
  title          String
  message        String
  type           String    @default("system")
  audienceType   String
  audienceDesc   String
  channels       Json
  status         String    @default("SENT") // SENT, SCHEDULED, FAILED
  scheduledFor   DateTime?
  sentBy         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  notifications  Notification[]
}

model NotificationTemplate {
  id           String    @id @default(uuid())
  name         String
  category     String
  title        String
  message      String
  isFavorite   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}


model NotificationPreference {
  id           String   @id @default(uuid())
  userId       String   @unique
  placement    Boolean  @default(true)
  interviews   Boolean  @default(true)
  meetings     Boolean  @default(true)
  messages     Boolean  @default(true)
  assignments  Boolean  @default(true)
  marketing    Boolean  @default(true)
  promotions   Boolean  @default(true)
  system       Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HrInvitationLink {
  id        String         @id @default(uuid())
  driveId   String
  token     String         @unique
  hrEmail   String
  isUsed    Boolean        @default(false)
  expiresAt DateTime
  createdAt DateTime       @default(now())
  drive     PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
}

model DriveAuditLog {
  id          String         @id @default(uuid())
  driveId     String
  action      String
  performedBy String
  comments    String?
  createdAt   DateTime       @default(now())
  drive       PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
}

model PlacementAnalytics {
  id               String   @id @default(uuid())
  forecastYear     Int
  actualMetrics    Json?
  predictedMetrics Json?
  modelVersion     String?
  predictionDate   DateTime @default(now())
  trend            String?
}

model ProfileUpdateRequest {
  id               String    @id @default(uuid())
  studentId        String
  requestedChanges Json
  previousValues   Json?
  changedFields    Json?
  reason           String?
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedBy       String?
  adminComment     String?
  
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ProfileAuditLog {
  id            String         @id @default(uuid())
  studentId     String
  action        String
  performedBy   String
  previousValue Json?
  newValue      Json?
  comments      String?
  createdAt     DateTime       @default(now())
  
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ImportedStudent {
  id                 String    @id @default(uuid())
  studentId          String    @map("student_id") // Fallback ID generated if missing
  fullName           String?   @map("full_name")
  email              String?
  department         String
  academicYear       String    @map("academic_year")
  studentStatus      String    @map("student_status") // "Regular" or "Alumni"
  gender             String?
  cgpa               Float?
  activeBacklogs     Int?      @map("active_backlogs")
  profileComplete    String?   @map("profile_complete")
  skills             String?
  driveId            String?   @map("drive_id")
  placementSeason    String?   @map("placement_season")
  applicationStatus  String?   @map("application_status")
  companyId          String?   @map("company_id")
  companyName        String?   @map("company_name")
  industry           String?
  fixedSalaryLpa     Float?    @map("fixed_salary_lpa")
  placementStatus    String?   @map("placement_status")

  sourceFile         String    @map("source_file")
  sourceFolder       String    @map("source_folder")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([studentId, academicYear])
  
  @@index([academicYear])
  @@index([department])
  @@index([studentStatus])
  @@index([academicYear, department])
  @@index([academicYear, studentStatus])
  @@index([placementStatus])
  @@index([academicYear, placementStatus])

  @@map("students")
}

model CustomCalendarEvent {
  id          String   @id @default(uuid())
  title       String
  start       DateTime
  end         DateTime
  type        String   @default("Event")
  color       String   @default("#4f46e5")
  description String?
  isAllDay    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AcademicYear {
  id        String     @id @default(uuid())
  year      String     @unique // e.g., "2026-2027"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(false)
  semesters Semester[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Semester {
  id             String       @id @default(uuid())
  name           String       // e.g., "Semester 7"
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean      @default(false)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, name])
}

model ReportTemplate {
  id           String   @id @default(uuid())
  name         String
  category     String
  description  String?
  filters      Json?
  columns      Json?
  isFavorite   Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ReportExportHistory {
  id           String   @id @default(uuid())
  reportName   String
  category     String
  status       String   @default("PROCESSING") // PENDING, PROCESSING, COMPLETED, FAILED
  fileUrl      String?
  format       String   @default("EXCEL") // EXCEL, CSV, PDF
  recordCount  Int      @default(0)
  generatedBy  String?
  filters      Json?
  errorDetails String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ScheduledReport {
  id           String   @id @default(uuid())
  reportName   String
  frequency    String   // DAILY, WEEKLY, MONTHLY
  filters      Json?
  format       String   @default("EXCEL")
  recipients   Json     // Array of emails or user IDs
  nextRunAt    DateTime?
  status       String   @default("ACTIVE") // ACTIVE, PAUSED
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  category    String   // e.g., GENERAL, PLACEMENT, SECURITY, REPORTS
  description String?
  isPublic    Boolean  @default(false)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  auditLogs   SettingAuditLog[]
}

model SettingAuditLog {
  id          String   @id @default(uuid())
  settingKey  String
  oldValue    Json?
  newValue    Json?
  changedBy   String
  createdAt   DateTime @default(now())

  setting     SystemSetting @relation(fields: [settingKey], references: [key], onDelete: Cascade)
}
