{
  "expo": {
    "name": "PlacementX",
    "slug": "placementx",
    "scheme": "placementx",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/nmims-placementx-launcher-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.placementx.app.demo",
      "associatedDomains": ["applinks:placementx-v1.vercel.app"],
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.placementx.app.demo",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F9F6EF",
        "foregroundImage": "./assets/nmims-placementx-launcher-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "placementx-v1.vercel.app", "pathPrefix": "/drives/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EFE8"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#7A1027",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ]
  }
}
